{%- comment -%}
  RetroCameraLand — Kamerani Sat (On Satin Alim) basvuru bolumu
  Self-contained Shopify section. Animasyonlu, scroll-reveal, 4+ foto yukleme.
  Basvurular section.settings.endpoint adresine POST edilir (Vercel /api/sell-camera).
  KAYNAK DOSYA: bu dosyayi duzenle, sonra `python3 build.py` ile ASCII-safe ciktiyi uret.
{%- endcomment -%}

{%- assign accent = section.settings.accent | default: '#FF4D2E' -%}
{%- assign accent2 = section.settings.accent2 | default: '#FF8A3D' -%}
{%- assign minph = section.settings.min_photos | default: 4 -%}

<style>
  #rclks-{{ section.id }}{
    --acc: {{ accent }};
    --acc2: {{ accent2 }};
    --bg: #0a0a0b;
    --card: rgba(255,255,255,.025);
    --card2: rgba(255,255,255,.04);
    --line: rgba(255,255,255,.09);
    --line2: rgba(255,255,255,.16);
    --txt: #f4f4f5;
    --mut: rgba(255,255,255,.46);
    --mut2: rgba(255,255,255,.30);
    --radius: 22px;
    --ff: -apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',Inter,system-ui,sans-serif;
  }
  #rclks-{{ section.id }} *{box-sizing:border-box;margin:0;padding:0}
  #rclks-{{ section.id }}{
    font-family:var(--ff); color:var(--txt);
    background:var(--bg);
    padding:clamp(40px,7vw,96px) clamp(16px,5vw,40px);
    position:relative; overflow:hidden;
    -webkit-font-smoothing:antialiased;
  }
  /* ambient glow */
  #rclks-{{ section.id }} .rclks-aura{position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.55}
  #rclks-{{ section.id }} .rclks-aura::before,
  #rclks-{{ section.id }} .rclks-aura::after{
    content:'';position:absolute;width:46vw;height:46vw;max-width:620px;max-height:620px;border-radius:50%;
    filter:blur(90px);opacity:.30;animation:rclksFloat 16s ease-in-out infinite;
  }
  #rclks-{{ section.id }} .rclks-aura::before{background:var(--acc);top:-12%;left:-8%}
  #rclks-{{ section.id }} .rclks-aura::after{background:var(--acc2);bottom:-16%;right:-10%;animation-delay:-8s}
  @keyframes rclksFloat{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(4%,5%) scale(1.12)}}

  #rclks-{{ section.id }} .rclks-wrap{position:relative;z-index:1;max-width:980px;margin:0 auto}

  /* ── HERO ── */
  #rclks-{{ section.id }} .rclks-hero{
    border:1px solid var(--line);border-radius:var(--radius);
    background:linear-gradient(160deg,rgba(255,255,255,.05),rgba(255,255,255,.012));
    backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
    padding:clamp(26px,4.5vw,46px); margin-bottom:22px; position:relative; overflow:hidden;
  }
  #rclks-{{ section.id }} .rclks-hero::after{
    content:'';position:absolute;top:0;left:0;right:0;height:1px;
    background:linear-gradient(90deg,transparent,var(--line2),transparent);
  }
  #rclks-{{ section.id }} .rclks-eyebrow{
    font-size:.66rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;
    color:var(--mut);display:flex;align-items:center;gap:9px;margin-bottom:18px;
  }
  #rclks-{{ section.id }} .rclks-eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--acc);box-shadow:0 0 12px var(--acc);animation:rclksPulse 2.4s ease-in-out infinite}
  @keyframes rclksPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.7)}}
  #rclks-{{ section.id }} .rclks-h1{
    font-size:clamp(2.05rem,6vw,3.7rem);line-height:1.04;letter-spacing:-.025em;font-weight:800;
    margin-bottom:18px;
  }
  #rclks-{{ section.id }} .rclks-h1 .em{
    background:linear-gradient(120deg,var(--acc),var(--acc2));
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  }
  #rclks-{{ section.id }} .rclks-sub{font-size:clamp(.95rem,2.2vw,1.12rem);line-height:1.6;color:var(--mut);max-width:620px;margin-bottom:26px}
  #rclks-{{ section.id }} .rclks-chips{display:flex;flex-wrap:wrap;gap:10px}
  #rclks-{{ section.id }} .rclks-chip{
    display:flex;align-items:center;gap:9px;font-size:.82rem;font-weight:500;color:rgba(255,255,255,.78);
    padding:10px 16px;border:1px solid var(--line);border-radius:999px;background:var(--card);
    transition:.3s cubic-bezier(.16,1,.3,1);
  }
  #rclks-{{ section.id }} .rclks-chip:hover{border-color:var(--line2);transform:translateY(-2px);color:#fff}
  #rclks-{{ section.id }} .rclks-chip .cd{width:7px;height:7px;border-radius:50%;background:var(--acc)}

  /* ── PROGRESS ── */
  #rclks-{{ section.id }} .rclks-prog{position:sticky;top:0;z-index:5;height:3px;background:rgba(255,255,255,.06);border-radius:99px;overflow:hidden;margin-bottom:22px}
  #rclks-{{ section.id }} .rclks-prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:99px;transition:width .5s cubic-bezier(.16,1,.3,1)}

  /* ── CARD / FORM ── */
  #rclks-{{ section.id }} .rclks-card{
    border:1px solid var(--line);border-radius:var(--radius);
    background:linear-gradient(160deg,rgba(255,255,255,.045),rgba(255,255,255,.01));
    backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
    padding:clamp(24px,4.5vw,48px);
  }
  #rclks-{{ section.id }} .rclks-lead h2{font-size:clamp(1.4rem,3.4vw,1.9rem);letter-spacing:-.02em;font-weight:800;margin-bottom:10px}
  #rclks-{{ section.id }} .rclks-lead p{color:var(--mut);font-size:.96rem;line-height:1.6;max-width:640px;margin-bottom:34px}

  #rclks-{{ section.id }} .rclks-step{margin-bottom:34px}
  #rclks-{{ section.id }} .rclks-steptitle{
    display:flex;align-items:center;gap:12px;font-size:1.06rem;font-weight:700;letter-spacing:-.01em;margin-bottom:20px;
  }
  #rclks-{{ section.id }} .rclks-steptitle .n{
    flex:0 0 auto;width:27px;height:27px;border-radius:9px;border:1px solid var(--line2);
    display:grid;place-items:center;font-size:.78rem;font-weight:700;color:var(--acc);
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:var(--card);
  }

  #rclks-{{ section.id }} .rclks-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  #rclks-{{ section.id }} .rclks-grid.one{grid-template-columns:1fr}
  @media (max-width:620px){#rclks-{{ section.id }} .rclks-grid{grid-template-columns:1fr}}

  /* floating-label field */
  #rclks-{{ section.id }} .rclks-field{position:relative}
  #rclks-{{ section.id }} .rclks-field label{
    position:absolute;left:17px;top:17px;font-size:.95rem;color:var(--mut);pointer-events:none;
    transition:.22s cubic-bezier(.16,1,.3,1);transform-origin:left top;
  }
  #rclks-{{ section.id }} .rclks-field input,
  #rclks-{{ section.id }} .rclks-field select,
  #rclks-{{ section.id }} .rclks-field textarea{
    width:100%;background:var(--card);border:1px solid var(--line);border-radius:15px;
    color:var(--txt);font-family:var(--ff);font-size:.98rem;padding:17px 17px 15px;outline:none;
    transition:.25s cubic-bezier(.16,1,.3,1);
  }
  #rclks-{{ section.id }} .rclks-field textarea{min-height:118px;resize:vertical;padding-top:24px}
  #rclks-{{ section.id }} .rclks-field select{appearance:none;cursor:pointer;padding-top:24px}
  #rclks-{{ section.id }} .rclks-field .chev{position:absolute;right:16px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--mut)}
  #rclks-{{ section.id }} .rclks-field input:focus,
  #rclks-{{ section.id }} .rclks-field select:focus,
  #rclks-{{ section.id }} .rclks-field textarea:focus{
    border-color:var(--acc);background:var(--card2);box-shadow:0 0 0 4px rgba(255,77,46,.12);
  }
  #rclks-{{ section.id }} .rclks-field input:focus + label,
  #rclks-{{ section.id }} .rclks-field input:not(:placeholder-shown) + label,
  #rclks-{{ section.id }} .rclks-field textarea:focus + label,
  #rclks-{{ section.id }} .rclks-field textarea:not(:placeholder-shown) + label,
  #rclks-{{ section.id }} .rclks-field.filled label{
    transform:translateY(-9px) scale(.74);color:var(--acc);font-weight:600;letter-spacing:.01em;
  }
  #rclks-{{ section.id }} .rclks-field.invalid input,
  #rclks-{{ section.id }} .rclks-field.invalid select,
  #rclks-{{ section.id }} .rclks-field.invalid textarea{border-color:#FF453A;box-shadow:0 0 0 4px rgba(255,69,58,.12)}

  /* segmented radios */
  #rclks-{{ section.id }} .rclks-qlabel{font-size:.86rem;font-weight:600;color:rgba(255,255,255,.82);margin-bottom:11px;display:block}
  #rclks-{{ section.id }} .rclks-seg{display:flex;flex-wrap:wrap;gap:10px}
  #rclks-{{ section.id }} .rclks-opt{
    flex:1 1 auto;min-width:120px;cursor:pointer;border:1px solid var(--line);border-radius:13px;
    padding:14px 16px;background:var(--card);transition:.22s cubic-bezier(.16,1,.3,1);
    display:flex;align-items:center;gap:11px;font-size:.92rem;user-select:none;position:relative;
  }
  #rclks-{{ section.id }} .rclks-opt:hover{border-color:var(--line2);background:var(--card2)}
  #rclks-{{ section.id }} .rclks-opt .rdot{
    flex:0 0 auto;width:18px;height:18px;border-radius:50%;border:2px solid var(--line2);
    display:grid;place-items:center;transition:.2s;
  }
  #rclks-{{ section.id }} .rclks-opt .rdot::after{content:'';width:8px;height:8px;border-radius:50%;background:var(--acc);transform:scale(0);transition:.2s cubic-bezier(.34,1.56,.64,1)}
  #rclks-{{ section.id }} .rclks-opt.sel{border-color:var(--acc);background:rgba(255,77,46,.08)}
  #rclks-{{ section.id }} .rclks-opt.sel .rdot{border-color:var(--acc)}
  #rclks-{{ section.id }} .rclks-opt.sel .rdot::after{transform:scale(1)}

  /* photo upload */
  #rclks-{{ section.id }} .rclks-photogrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px}
  #rclks-{{ section.id }} .rclks-slot{
    position:relative;aspect-ratio:1;border:1.5px dashed var(--line2);border-radius:16px;
    background:var(--card);cursor:pointer;overflow:hidden;transition:.25s cubic-bezier(.16,1,.3,1);
    display:grid;place-items:center;text-align:center;
  }
  #rclks-{{ section.id }} .rclks-slot:hover{border-color:var(--acc);background:var(--card2);transform:translateY(-2px)}
  #rclks-{{ section.id }} .rclks-slot.drag{border-color:var(--acc);background:rgba(255,77,46,.08);transform:scale(1.02)}
  #rclks-{{ section.id }} .rclks-slot .ph{display:flex;flex-direction:column;align-items:center;gap:7px;color:var(--mut);padding:10px}
  #rclks-{{ section.id }} .rclks-slot .ph svg{width:24px;height:24px;opacity:.7}
  #rclks-{{ section.id }} .rclks-slot .ph small{font-size:.72rem;line-height:1.3}
  #rclks-{{ section.id }} .rclks-slot.has img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  #rclks-{{ section.id }} .rclks-slot.has .ph{display:none}
  #rclks-{{ section.id }} .rclks-slot .rm{
    position:absolute;top:7px;right:7px;width:26px;height:26px;border-radius:50%;border:none;
    background:rgba(0,0,0,.6);backdrop-filter:blur(8px);color:#fff;cursor:pointer;display:none;
    place-items:center;z-index:2;transition:.2s;
  }
  #rclks-{{ section.id }} .rclks-slot.has .rm{display:grid}
  #rclks-{{ section.id }} .rclks-slot .rm:hover{background:#FF453A}
  #rclks-{{ section.id }} .rclks-slot .tag{
    position:absolute;left:7px;bottom:7px;font-size:.62rem;font-weight:600;letter-spacing:.04em;
    padding:3px 8px;border-radius:7px;background:rgba(0,0,0,.55);backdrop-filter:blur(8px);color:#fff;z-index:2;
  }
  #rclks-{{ section.id }} .rclks-slot.uploading::after{
    content:'';position:absolute;inset:0;background:rgba(10,10,11,.55);
    background-image:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent);
    background-size:200% 100%;animation:rclksShimmer 1.1s linear infinite;z-index:3;
  }
  @keyframes rclksShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
  #rclks-{{ section.id }} .rclks-photonote{font-size:.78rem;color:var(--mut2);margin-top:12px;display:flex;align-items:center;gap:7px}
  #rclks-{{ section.id }} .rclks-photonote b{color:var(--acc);font-weight:600}

  /* submit */
  #rclks-{{ section.id }} .rclks-submit{
    width:100%;margin-top:8px;border:none;border-radius:16px;cursor:pointer;position:relative;overflow:hidden;
    background:linear-gradient(120deg,var(--acc),var(--acc2));color:#fff;
    font-family:var(--ff);font-size:1.02rem;font-weight:700;letter-spacing:.01em;padding:19px;
    transition:.25s cubic-bezier(.16,1,.3,1);box-shadow:0 12px 34px -12px rgba(255,77,46,.6);
  }
  #rclks-{{ section.id }} .rclks-submit:hover{transform:translateY(-2px);box-shadow:0 18px 44px -12px rgba(255,77,46,.7)}
  #rclks-{{ section.id }} .rclks-submit:active{transform:translateY(0)}
  #rclks-{{ section.id }} .rclks-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}
  #rclks-{{ section.id }} .rclks-submit::before{
    content:'';position:absolute;top:0;left:-120%;width:60%;height:100%;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);
  }
  #rclks-{{ section.id }} .rclks-submit:hover::before{animation:rclksSheen 1.1s ease}
  @keyframes rclksSheen{to{left:140%}}
  #rclks-{{ section.id }} .rclks-submit .spin{display:none;width:18px;height:18px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:rclksSpin .7s linear infinite;vertical-align:-3px;margin-right:9px}
  @keyframes rclksSpin{to{transform:rotate(360deg)}}
  #rclks-{{ section.id }} .rclks-submit.loading .spin{display:inline-block}
  #rclks-{{ section.id }} .rclks-submit.loading .lbl{opacity:.85}

  #rclks-{{ section.id }} .rclks-err{display:none;margin-top:14px;padding:13px 16px;border-radius:12px;border:1px solid rgba(255,69,58,.35);background:rgba(255,69,58,.08);color:#ff9a91;font-size:.88rem;line-height:1.5}
  #rclks-{{ section.id }} .rclks-err.show{display:block;animation:rclksShake .4s}
  @keyframes rclksShake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}
  #rclks-{{ section.id }} .rclks-mini{font-size:.74rem;color:var(--mut2);text-align:center;margin-top:16px;line-height:1.5}
  #rclks-{{ section.id }} .rclks-member{display:flex;flex-wrap:wrap;align-items:center;gap:10px;justify-content:space-between;border:1px solid var(--line);border-radius:14px;background:var(--card);padding:13px 16px;margin-bottom:26px;font-size:.86rem;color:var(--mut);line-height:1.5}
  #rclks-{{ section.id }} .rclks-member b{color:var(--txt);font-weight:600}
  #rclks-{{ section.id }} .rclks-member a{color:var(--acc);text-decoration:none;font-weight:600}
  #rclks-{{ section.id }} .rclks-member.is-in{border-color:rgba(61,220,132,.3);background:rgba(61,220,132,.06)}
  #rclks-{{ section.id }} .rclks-mdot{width:8px;height:8px;border-radius:50%;background:#3DDC84;box-shadow:0 0 10px #3DDC84;flex:0 0 auto}
  #rclks-{{ section.id }} .rclks-mlinks{display:flex;gap:8px;flex:0 0 auto}
  #rclks-{{ section.id }} .rclks-mlinks a{padding:8px 15px;border:1px solid var(--line2);border-radius:10px}
  #rclks-{{ section.id }} .rclks-mlinks a.reg{background:var(--acc);border-color:var(--acc);color:#fff}

  /* success */
  #rclks-{{ section.id }} .rclks-success{display:none;text-align:center;padding:clamp(30px,6vw,60px) 10px}
  #rclks-{{ section.id }} .rclks-success.show{display:block;animation:rclksFadeUp .6s cubic-bezier(.16,1,.3,1)}
  #rclks-{{ section.id }} .rclks-check{
    width:84px;height:84px;border-radius:50%;margin:0 auto 26px;display:grid;place-items:center;
    background:linear-gradient(120deg,var(--acc),var(--acc2));box-shadow:0 14px 40px -10px rgba(255,77,46,.6);
  }
  #rclks-{{ section.id }} .rclks-check svg{width:42px;height:42px;stroke:#fff;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
  #rclks-{{ section.id }} .rclks-check svg path{stroke-dasharray:48;stroke-dashoffset:48;animation:rclksDraw .5s .25s forwards cubic-bezier(.16,1,.3,1)}
  @keyframes rclksDraw{to{stroke-dashoffset:0}}
  #rclks-{{ section.id }} .rclks-success h3{font-size:clamp(1.5rem,4vw,2rem);font-weight:800;letter-spacing:-.02em;margin-bottom:12px}
  #rclks-{{ section.id }} .rclks-success p{color:var(--mut);font-size:1rem;line-height:1.6;max-width:440px;margin:0 auto 26px}
  #rclks-{{ section.id }} .rclks-again{border:1px solid var(--line2);background:var(--card);color:var(--txt);border-radius:13px;padding:13px 26px;font-family:var(--ff);font-size:.92rem;font-weight:600;cursor:pointer;transition:.22s}
  #rclks-{{ section.id }} .rclks-again:hover{background:var(--card2);border-color:var(--acc)}

  /* scroll reveal */
  #rclks-{{ section.id }} .rcl-rv{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  #rclks-{{ section.id }} .rcl-rv.in{opacity:1;transform:none}
  @keyframes rclksFadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){
    #rclks-{{ section.id }} *{animation:none!important;transition:none!important}
    #rclks-{{ section.id }} .rcl-rv{opacity:1;transform:none}
  }
</style>

<section id="rclks-{{ section.id }}">
  <div class="rclks-aura"></div>
  <div class="rclks-wrap">

    <!-- HERO -->
    <div class="rclks-hero rcl-rv">
      <div class="rclks-eyebrow"><span class="dot"></span> RETROCAMERALAND · ÖN SATIN ALIM</div>
      <h1 class="rclks-h1">Kameranı Satmak Hiç Bu Kadar <span class="em">Kolay Olmamıştı.</span></h1>
      <p class="rclks-sub">Bilgilerini doldur, en az {{ minph }} fotoğraf yükle, fiyat beklentini yaz. Ekibimiz kameranı inceleyip en kısa sürede sana dönüş yapsın.</p>
      <div class="rclks-chips">
        <span class="rclks-chip"><span class="cd"></span> 1 dakikada doldur</span>
        <span class="rclks-chip"><span class="cd"></span> {{ minph }}+ fotoğraf yükle</span>
        <span class="rclks-chip"><span class="cd"></span> Hızlı geri dönüş</span>
        <span class="rclks-chip"><span class="cd"></span> Güvenli süreç</span>
      </div>
    </div>

    <div class="rclks-prog rcl-rv"><i id="rclks-bar"></i></div>

    <!-- FORM CARD -->
    <div class="rclks-card rcl-rv">
      <form id="rclks-form" novalidate>
        <div class="rclks-lead">
          <h2>Kameranı Sat!</h2>
          <p>Kullanmadığın dijital kamerayı RetroCameraLand’e satmak artık çok kolay. Bilgilerini doldur, en az {{ minph }} fotoğraf yükle, fiyat beklentini yaz, ekibimiz inceleyip sana dönüş yapsın.</p>
        </div>

        {%- if customer -%}
          <div class="rclks-member is-in">
            <span class="rclks-mdot"></span>
            <span><b>Üye olarak gönderiyorsun.</b> Başvurunu ve gelen teklifleri <a href="/pages/basvurularim">Başvurularım</a> sayfasından takip edebilirsin. ({{ customer.email }})</span>
          </div>
        {%- else -%}
          <div class="rclks-member">
            <span><b>İpucu:</b> Üye olursan başvurunun durumunu ve sana özel teklifleri hesabından takip edebilirsin.</span>
            <span class="rclks-mlinks"><a href="/account/login">Giriş Yap</a><a href="/account/register" class="reg">Üye Ol</a></span>
          </div>
        {%- endif -%}

        <!-- STEP 1: Iletisim -->
        <div class="rclks-step">
          <div class="rclks-steptitle"><span class="n">1</span> İletişim Bilgilerin</div>
          <div class="rclks-grid">
            <div class="rclks-field"><input type="text" id="f-name" name="name" placeholder=" " autocomplete="name" required><label for="f-name">Ad Soyad *</label></div>
            <div class="rclks-field"><input type="tel" id="f-phone" name="phone" placeholder=" " autocomplete="tel" inputmode="tel" required><label for="f-phone">Cep Telefonu *</label></div>
          </div>
          <div class="rclks-grid one" style="margin-top:16px">
            <div class="rclks-field"><input type="email" id="f-email" name="email" placeholder=" " autocomplete="email" inputmode="email" required><label for="f-email">E-Posta Adresi *</label></div>
          </div>
        </div>

        <!-- STEP 2: Gonderim -->
        <div class="rclks-step">
          <div class="rclks-steptitle"><span class="n">2</span> Gönderim Bilgisi</div>
          <div class="rclks-grid one">
            <div class="rclks-field filled">
              <select id="f-city" name="city" required>
                <option value="İstanbul Avrupa Yakası">İstanbul Avrupa Yakası</option>
                <option value="İstanbul Anadolu Yakası">İstanbul Anadolu Yakası</option>
                <option value="Ankara">Ankara</option>
                <option value="İzmir">İzmir</option>
                <option value="Bursa">Bursa</option>
                <option value="Antalya">Antalya</option>
                <option value="Diğer İl">Diğer İl</option>
              </select>
              <label for="f-city">Gönderim Yapacağın İl *</label>
              <span class="chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            </div>
          </div>
        </div>

        <!-- STEP 3: Kamera Detaylari -->
        <div class="rclks-step">
          <div class="rclks-steptitle"><span class="n">3</span> Kamera Detayları</div>
          <div class="rclks-grid">
            <div class="rclks-field"><input type="text" id="f-model" name="model" placeholder=" " required><label for="f-model">Marka - Model *</label></div>
            <div class="rclks-field"><input type="text" id="f-price" name="price" placeholder=" " inputmode="numeric" required><label for="f-price">Fiyat Beklentin (TL) *</label></div>
          </div>

          <div class="rclks-grid" style="margin-top:22px">
            <div>
              <span class="rclks-qlabel">Orijinal kutusu var mı? *</span>
              <div class="rclks-seg" data-radio="box">
                <div class="rclks-opt" data-val="Var"><span class="rdot"></span> Var</div>
                <div class="rclks-opt" data-val="Yok"><span class="rdot"></span> Yok</div>
                <div class="rclks-opt" data-val="Kısmen (aksesuar var)"><span class="rdot"></span> Kısmen (aksesuar var)</div>
              </div>
            </div>
            <div>
              <span class="rclks-qlabel">Kamera Çalışıyor mu? *</span>
              <div class="rclks-seg" data-radio="working">
                <div class="rclks-opt" data-val="Evet"><span class="rdot"></span> Evet</div>
                <div class="rclks-opt" data-val="Hayır"><span class="rdot"></span> Hayır</div>
              </div>
            </div>
          </div>

          <div style="margin-top:22px">
            <span class="rclks-qlabel">Kameranın Kasasında Kusur veya Arıza Var mı? *</span>
            <div class="rclks-seg" data-radio="condition">
              <div class="rclks-opt" data-val="Kusursuz kondisyonda"><span class="rdot"></span> Kusursuz Kondisyonda</div>
              <div class="rclks-opt" data-val="Hafif çizikler, problemsiz çalışıyor"><span class="rdot"></span> Hafif çizik, sorunsuz</div>
              <div class="rclks-opt" data-val="Çizik / kırık var"><span class="rdot"></span> Çizik, kırık var</div>
            </div>
          </div>

          <div class="rclks-grid one" style="margin-top:22px">
            <div class="rclks-field"><textarea id="f-missing" name="missing" placeholder=" "></textarea><label for="f-missing">Eksik Parça / Aksesuar Detayları</label></div>
          </div>
        </div>

        <!-- STEP 4: Fotograflar -->
        <div class="rclks-step">
          <div class="rclks-steptitle"><span class="n">4</span> Fotoğraflar (en az {{ minph }})</div>
          <div class="rclks-photogrid" id="rclks-photos"></div>
          <div class="rclks-photonote">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Ön, arka, üst ve lens/detay açılarından net çekimler en hızlı değerlendirmeyi sağlar. <b id="rclks-photocount">0/{{ minph }}</b></span>
          </div>
        </div>

        <button type="submit" class="rclks-submit" id="rclks-btn">
          <span class="spin"></span><span class="lbl">Başvuruyu Gönder</span>
        </button>
        <div class="rclks-err" id="rclks-err"></div>
        <p class="rclks-mini">Gönderdiğin bilgiler yalnızca değerlendirme amacıyla RetroCameraLand ekibiyle paylaşılır. Spam yok, satış zorunluluğu yok.</p>
      </form>

      <!-- SUCCESS -->
      <div class="rclks-success" id="rclks-success">
        <div class="rclks-check"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></div>
        <h3>Başvurun Bize Ulaştı!</h3>
        <p>Teşekkürler! Ekibimiz kameranı inceleyip en kısa sürede telefon veya e-posta ile sana dönüş yapacak. Referans numaran: <b id="rclks-ref"></b></p>
        <button class="rclks-again" id="rclks-again">Yeni Başvuru Yap</button>
      </div>
    </div>

  </div>

  <script>
  (function(){
    var ROOT = document.getElementById('rclks-' + {{ section.id | json }});
    if(!ROOT || ROOT.dataset.init) return; ROOT.dataset.init = '1';
    var ENDPOINT = {{ section.settings.endpoint | default: 'https://rclhq.vercel.app/api/sell-camera' | json }};
    var MINPH = {{ minph | json }};
    var MAXPH = 8;
    {%- if customer -%}
    var MEMBER = { email: {{ customer.email | json }}, name: {{ customer.name | json }} };
    {%- else -%}
    var MEMBER = null;
    {%- endif -%}
    var $ = function(s){ return ROOT.querySelector(s); };
    var $$ = function(s){ return Array.prototype.slice.call(ROOT.querySelectorAll(s)); };

    /* scroll reveal */
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold:.12 });
    $$('.rcl-rv').forEach(function(el,i){ el.style.transitionDelay = (i*0.06)+'s'; io.observe(el); });

    /* radios */
    var radios = { box:'', working:'', condition:'' };
    $$('.rclks-seg').forEach(function(seg){
      var key = seg.getAttribute('data-radio');
      seg.querySelectorAll('.rclks-opt').forEach(function(opt){
        opt.addEventListener('click', function(){
          seg.querySelectorAll('.rclks-opt').forEach(function(o){ o.classList.remove('sel'); });
          opt.classList.add('sel');
          radios[key] = opt.getAttribute('data-val');
          updateProgress();
        });
      });
    });

    /* phone format */
    var ph = $('#f-phone');
    ph.addEventListener('input', function(){
      var d = ph.value.replace(/\D/g,'').slice(0,11);
      var out = d;
      if(d.length>0){ out = d.slice(0,4); if(d.length>4) out += ' ' + d.slice(4,7); if(d.length>7) out += ' ' + d.slice(7,9); if(d.length>9) out += ' ' + d.slice(9,11); }
      ph.value = out;
    });

    /* photo slots */
    var photos = [];
    var grid = $('#rclks-photos');
    var slotTags = ['Ön','Arka','Üst / Alt','Lens / Detay','Ek 1','Ek 2','Ek 3','Ek 4'];
    function buildSlots(){
      grid.innerHTML = '';
      var n = Math.max(MINPH, Math.min(MAXPH, photos.length + 1));
      for(var i=0;i<n;i++){ grid.appendChild(makeSlot(i)); }
    }
    function makeSlot(i){
      var el = document.createElement('div');
      el.className = 'rclks-slot' + (photos[i] ? ' has' : '');
      var tag = slotTags[i] || ('Foto ' + (i+1));
      el.innerHTML = (photos[i] ? '<img src="'+photos[i]+'" alt="">' : '') +
        '<div class="ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="M21 15l-5-5L5 21"/></svg><small>' + tag + '<br>ekle</small></div>' +
        '<span class="tag">' + tag + '</span>' +
        '<button type="button" class="rm" aria-label="Kaldır"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';
      var input = document.createElement('input');
      input.type='file'; input.accept='image/*'; input.style.display='none';
      el.appendChild(input);
      el.addEventListener('click', function(e){ if(e.target.closest('.rm')) return; input.click(); });
      input.addEventListener('change', function(){ if(input.files && input.files[0]) handleFile(input.files[0], i, el); });
      el.querySelector('.rm').addEventListener('click', function(e){ e.stopPropagation(); photos.splice(i,1); buildSlots(); updatePhotoCount(); updateProgress(); });
      el.addEventListener('dragover', function(e){ e.preventDefault(); el.classList.add('drag'); });
      el.addEventListener('dragleave', function(){ el.classList.remove('drag'); });
      el.addEventListener('drop', function(e){ e.preventDefault(); el.classList.remove('drag'); if(e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0], i, el); });
      return el;
    }
    function handleFile(file, i, el){
      if(!file.type.match(/^image\//)){ flashErr('Lütfen yalnızca görsel dosyası yükle.'); return; }
      el.classList.add('uploading');
      compress(file, function(dataUrl){
        if(i >= photos.length) photos.push(dataUrl); else photos[i] = dataUrl;
        buildSlots(); updatePhotoCount(); updateProgress();
      });
    }
    function compress(file, cb){
      var img = new Image();
      var rd = new FileReader();
      rd.onload = function(){ img.src = rd.result; };
      img.onload = function(){
        var max = 1280, w = img.width, h = img.height;
        if(w>h && w>max){ h = Math.round(h*max/w); w = max; }
        else if(h>=w && h>max){ w = Math.round(w*max/h); h = max; }
        var c = document.createElement('canvas'); c.width=w; c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        cb(c.toDataURL('image/jpeg', 0.78));
      };
      img.onerror = function(){ flashErr('Görsel okunamadı, başka bir foto dene.'); };
      rd.readAsDataURL(file);
    }
    function updatePhotoCount(){
      var c = $('#rclks-photocount');
      c.textContent = photos.length + '/' + MINPH;
      c.style.color = photos.length >= MINPH ? '#3DDC84' : '';
    }
    buildSlots();

    /* progress bar */
    var reqInputs = ['#f-name','#f-phone','#f-email','#f-model','#f-price'];
    function fieldFilled(el){
      if(el.parentElement && el.parentElement.classList){ el.parentElement.classList.toggle('filled', !!el.value.trim()); }
      return !!el.value.trim();
    }
    function updateProgress(){
      var total = reqInputs.length + 3 + 1; // inputs + 3 radios + photos
      var done = 0;
      reqInputs.forEach(function(s){ if(fieldFilled($(s))) done++; });
      if(radios.box) done++; if(radios.working) done++; if(radios.condition) done++;
      if(photos.length >= MINPH) done++;
      $('#rclks-bar').style.width = Math.round(done/total*100) + '%';
    }
    $$('#rclks-form input, #rclks-form select, #rclks-form textarea').forEach(function(el){
      el.addEventListener('input', function(){ fieldFilled(el); updateProgress(); });
      el.addEventListener('blur', function(){ fieldFilled(el); });
    });
    if(MEMBER){
      if(MEMBER.name){ var _nf=$('#f-name'); if(_nf && !_nf.value.trim()){ _nf.value=MEMBER.name; fieldFilled(_nf); } }
      if(MEMBER.email){ var _ef=$('#f-email'); if(_ef && !_ef.value.trim()){ _ef.value=MEMBER.email; fieldFilled(_ef); } }
    }
    updateProgress();

    /* error helper */
    var errBox = $('#rclks-err');
    var errTimer;
    function flashErr(msg){
      errBox.textContent = msg; errBox.classList.add('show');
      clearTimeout(errTimer); errTimer = setTimeout(function(){ errBox.classList.remove('show'); }, 5000);
    }
    function markInvalid(el){ if(el && el.parentElement) el.parentElement.classList.add('invalid'); }
    $$('#rclks-form input, #rclks-form textarea').forEach(function(el){ el.addEventListener('input', function(){ if(el.parentElement) el.parentElement.classList.remove('invalid'); }); });

    /* validate + submit */
    var btn = $('#rclks-btn');
    $('#rclks-form').addEventListener('submit', function(e){
      e.preventDefault();
      errBox.classList.remove('show');
      $$('.rclks-field').forEach(function(f){ f.classList.remove('invalid'); });

      var name=$('#f-name'), phone=$('#f-phone'), email=$('#f-email'), model=$('#f-model'), price=$('#f-price');
      var bad = null;
      if(!name.value.trim()){ markInvalid(name); bad = bad||name; }
      if(phone.value.replace(/\D/g,'').length < 10){ markInvalid(phone); bad = bad||phone; }
      if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value.trim())){ markInvalid(email); bad = bad||email; }
      if(!model.value.trim()){ markInvalid(model); bad = bad||model; }
      if(!price.value.trim()){ markInvalid(price); bad = bad||price; }
      if(bad){ flashErr('Lütfen işaretli zorunlu alanları doldur.'); bad.focus(); return; }
      if(!radios.box || !radios.working || !radios.condition){ flashErr('Lütfen kamera durumu sorularını yanıtla.'); return; }
      if(photos.length < MINPH){ flashErr('Lütfen en az ' + MINPH + ' fotoğraf yükle. (' + photos.length + '/' + MINPH + ')'); return; }

      var payload = {
        name: name.value.trim(),
        phone: phone.value.trim(),
        email: email.value.trim(),
        city: $('#f-city').value,
        model: model.value.trim(),
        price: price.value.trim(),
        box: radios.box,
        working: radios.working,
        condition: radios.condition,
        missing: $('#f-missing').value.trim(),
        photos: photos,
        memberEmail: MEMBER ? MEMBER.email : '',
        source: 'shopify-section',
        page: location.href
      };

      btn.classList.add('loading'); btn.disabled = true;
      fetch(ENDPOINT, {
        method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
      }).then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ return { ok:r.ok, j:j }; }); })
        .then(function(res){
          if(!res.ok){ throw new Error(res.j && res.j.error ? res.j.error : 'Sunucu hatası'); }
          $('#rclks-form').style.display = 'none';
          $('#rclks-ref').textContent = (res.j && res.j.ref) ? res.j.ref : '-';
          var sc = $('#rclks-success'); sc.classList.add('show');
          sc.scrollIntoView({ behavior:'smooth', block:'center' });
        })
        .catch(function(err){
          flashErr('Gönderilemedi: ' + (err.message||'bağlantı hatası') + '. Lütfen tekrar dene.');
          btn.classList.remove('loading'); btn.disabled = false;
        });
    });

    $('#rclks-again').addEventListener('click', function(){
      photos = []; radios = { box:'', working:'', condition:'' };
      $('#rclks-form').reset();
      $$('.rclks-opt').forEach(function(o){ o.classList.remove('sel'); });
      $$('.rclks-field').forEach(function(f){ f.classList.remove('filled','invalid'); });
      $('#rclks-form').style.display = '';
      $('#rclks-success').classList.remove('show');
      buildSlots(); updatePhotoCount(); updateProgress();
      ROOT.scrollIntoView({ behavior:'smooth', block:'start' });
    });
  })();
  </script>
</section>

{% schema %}
{
  "name": "RCL Kamerani Sat",
  "tag": "section",
  "class": "rcl-kamera-sat-section",
  "settings": [
    { "type": "header", "content": "Bağlantı" },
    { "type": "text", "id": "endpoint", "label": "Başvuru API adresi", "default": "https://rclhq.vercel.app/api/sell-camera", "info": "Vercel /api/sell-camera adresi. Başvurular buraya gönderilir." },
    { "type": "header", "content": "Görünüm" },
    { "type": "color", "id": "accent", "label": "Vurgu rengi", "default": "#FF4D2E" },
    { "type": "color", "id": "accent2", "label": "Vurgu rengi 2 (gradyan)", "default": "#FF8A3D" },
    { "type": "range", "id": "min_photos", "label": "Minimum fotoğraf sayısı", "min": 3, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [
    { "name": "RCL Kamerani Sat" }
  ]
}
{% endschema %}
