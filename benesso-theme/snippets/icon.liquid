  {%- when 'mountain' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 19 6-11 4 7 2-3 6 7z"/></svg>
