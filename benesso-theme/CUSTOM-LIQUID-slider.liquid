<!--
============================================================
  BENESSO 16:9 KAYDIRMALI SLIDER — Ozel Liquid (Custom Liquid)
  ------------------------------------------------------------
  NASIL EKLENIR:
  1) Tema Editoru -> "Bolum ekle" -> "Ozel Liquid" (Custom Liquid)
  2) Bu kodun TAMAMINI kutuya yapistir -> Kaydet.

  GORSELLERI YUKLEMEK (ONEMLI):
  - Yonetici -> Icerik -> Dosyalar (Content -> Files) bolumune su adlarla yukle:
      madvanilla_slider2.jpg
      elparaiso.jpg
      ucluslider.jpg
  - Kod bu dosyalari adindan otomatik ceker ( {{ 'ad.jpg' | file_url }} ).
  - Dosya adi farkliysa asagidaki src icindeki adi ona gore degistir.

  LINK: her slaytta <a href="/products/..."> urune gider. Gorsele tiklanir.
  YAZI: yok - yazi gorselin uzerinde. Overlay kaldirildi.

  SLAYT EKLEMEK / CIKARMAK:
  - Asagida "SLAYT" yazan <div class="bspec-slide">...</div> blogunu
    kopyala-yapistir (eklemek) veya sil (cikarmak). Noktalar otomatik olusur.
  AYARLAR: asagidaki data-autoplay / data-interval / data-dots
============================================================
-->

<div class="bspec-wrap">
  <div class="bspec-slider" data-autoplay="true" data-interval="5000" data-dots="true">
    <div class="bspec-track">

      <!-- SLAYT 1 -->
      <div class="bspec-slide">
        <a class="bspec-link" href="/products/madvanilla-coffee">
          <img class="bspec-img" src="{{ 'madvanilla_slider2.jpg' | file_url }}" alt="Madvanilla Coffee" width="1600" height="900" loading="eager">
        </a>
      </div>

      <!-- SLAYT 2 -->
      <div class="bspec-slide">
        <a class="bspec-link" href="/products/colombia-el-paraiso-anaerobic-natural">
          <img class="bspec-img" src="{{ 'elparaiso.jpg' | file_url }}" alt="Colombia El Paraiso Anaerobic Natural" width="1600" height="900" loading="lazy">
        </a>
      </div>

      <!-- SLAYT 3 -->
      <div class="bspec-slide">
        <a class="bspec-link" href="/products/3lu-tadim-seti">
          <img class="bspec-img" src="{{ 'ucluslider.jpg' | file_url }}" alt="3'lu Tadim Seti" width="1600" height="900" loading="lazy">
        </a>
      </div>

    </div>
    <div class="bspec-dots"></div>
  </div>
</div>

<style>
  .bspec-wrap { width:100%; max-width:1320px; margin-inline:auto; padding-inline:24px; box-sizing:border-box; }
  .bspec-slider { position:relative; border-radius:28px; overflow:hidden; box-shadow:0 24px 70px rgba(15,10,6,.40); }
  .bspec-track { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  .bspec-track::-webkit-scrollbar { display:none; }
  .bspec-slide { position:relative; flex:0 0 100%; width:100%; scroll-snap-align:center; scroll-snap-stop:always; aspect-ratio:16/9; }
  .bspec-slide > a { display:block; width:100%; height:100%; }
  .bspec-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .bspec-overlay { position:absolute; inset:0; display:flex; padding:clamp(1.2rem,4vw,3rem); box-sizing:border-box; background:linear-gradient(to top, rgba(15,10,6,.78), rgba(15,10,6,.10) 55%, transparent 80%); }
  .bspec-left   { align-items:flex-end; justify-content:flex-start; text-align:left; }
  .bspec-center { align-items:center; justify-content:center; text-align:center; background:linear-gradient(to top, rgba(15,10,6,.55), rgba(15,10,6,.30)); }
  .bspec-right  { align-items:flex-end; justify-content:flex-end; text-align:right; }
  .bspec-cap { max-width:46ch; color:#fff; }
  .bspec-tag { display:inline-block; font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; color:#fff; padding:.35rem .8rem; margin-bottom:.8rem; border:1px solid rgba(255,255,255,.22); border-radius:999px; background:rgba(23,17,13,.42); -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px); }
  .bspec-title { font-size:clamp(1.5rem,4vw,2.8rem); line-height:1.05; color:#fff; margin:0; font-weight:700; }
  .bspec-text { margin:.6rem 0 0; font-size:clamp(.95rem,1.6vw,1.15rem); color:rgba(255,255,255,.82); }
  .bspec-dots { position:absolute; left:0; right:0; bottom:clamp(.9rem,2vw,1.4rem); display:flex; justify-content:center; gap:.5rem; z-index:2; }
  .bspec-dot { width:8px; height:8px; padding:0; border:0; border-radius:999px; cursor:pointer; background:rgba(255,255,255,.45); transition:width .3s cubic-bezier(.22,1,.36,1), background .3s; }
  .bspec-dot.is-active { width:26px; background:#D4621A; }
  /* Mobilde kenardan kenara: tema container dolgusunu da asar, kose yuvarlatmasini kaldirir */
  @media (max-width:749px) {
    .bspec-wrap { width:100vw; max-width:100vw; margin-left:50%; transform:translateX(-50%); padding-inline:0; }
    .bspec-slider { border-radius:0; box-shadow:none; }
  }
  @media (prefers-reduced-motion: reduce) { .bspec-track { scroll-behavior:auto; } }
</style>

<script>
(function () {
  function init(root) {
    if (root.dataset.ready) return; root.dataset.ready = '1';
    var track = root.querySelector('.bspec-track');
    var slides = root.querySelectorAll('.bspec-slide');
    var dotsBox = root.querySelector('.bspec-dots');
    if (!track || slides.length < 2) { if (dotsBox) dotsBox.style.display = 'none'; return; }
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0, dots = [];

    function setActive(i) { current = i; dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); }); }
    function goTo(i) { var s = slides[i]; if (s) track.scrollTo({ left: s.offsetLeft, behavior: reduce ? 'auto' : 'smooth' }); }

    if (root.dataset.dots === 'true' && dotsBox) {
      for (var i = 0; i < slides.length; i++) {
        (function (idx) {
          var b = document.createElement('button');
          b.className = 'bspec-dot' + (idx === 0 ? ' is-active' : '');
          b.type = 'button'; b.setAttribute('aria-label', 'Slayt ' + (idx + 1));
          b.addEventListener('click', function () { goTo(idx); });
          dotsBox.appendChild(b); dots.push(b);
        })(i);
      }
    } else if (dotsBox) { dotsBox.style.display = 'none'; }

    var raf;
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== current) setActive(Math.max(0, Math.min(slides.length - 1, i)));
      });
    }, { passive: true });

    if (root.dataset.autoplay === 'true' && !reduce) {
      var iv = parseInt(root.dataset.interval, 10) || 5000, t = null;
      function start() { stop(); t = setInterval(function () { goTo((current + 1) % slides.length); }, iv); }
      function stop() { if (t) { clearInterval(t); t = null; } }
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      track.addEventListener('touchstart', stop, { passive: true });
      document.addEventListener('visibilitychange', function () { if (document.hidden) { stop(); } else { start(); } });
      start();
    }
  }
  function boot() { var all = document.querySelectorAll('.bspec-slider'); for (var i = 0; i < all.length; i++) init(all[i]); }
  if (document.readyState !== 'loading') { boot(); } else { document.addEventListener('DOMContentLoaded', boot); }
})();
</script>
