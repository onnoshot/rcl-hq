<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Hediye Kartı</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Space+Mono&family=Inter&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body style="min-height:100vh;display:grid;place-items:center;padding:2rem">
  <div class="liquid-bg" aria-hidden="true"><span class="liquid-blob liquid-blob--1"></span><span class="liquid-blob liquid-blob--2"></span></div>
  <main class="glass--strong glass center" style="max-width:440px;padding:2.5rem;border-radius:var(--radius-lg)">
    <span class="site-logo" style="justify-content:center;font-size:1.5rem">{{ settings.logo_text }}<span>{{ settings.logo_accent }}</span></span>
    <span class="eyebrow" style="justify-content:center;margin-top:1rem">{% render 'icon', name: 'cup' %} HEDİYE KARTI</span>
    <div class="flow-text" style="font-family:var(--font-display);font-size:3rem;font-weight:700;margin:.5rem 0">{{ gift_card.balance | money }}</div>
    {%- if gift_card.expired -%}<p class="chip chip--note" style="margin-inline:auto">Süresi doldu</p>{%- endif -%}
    {{ gift_card.qr_identifier }}
    <div class="glass" style="padding:1rem;margin:1.5rem 0;font-family:var(--font-mono);letter-spacing:.15em;font-size:1.1rem">{{ gift_card.code | format_code }}</div>
    <a href="{{ shop.url }}" class="btn btn--block" data-magnetic>Kahveleri keşfet {% render 'icon', name: 'arrow' %}</a>
  </main>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
