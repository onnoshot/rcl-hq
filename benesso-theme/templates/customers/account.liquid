<section class="section wrap">
  <header style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:2rem">
    <div>
      <span class="eyebrow">{% render 'icon', name: 'user' %} {{ 'customer.account.title' | t }}</span>
      <h1 class="section-title" style="font-size:var(--fs-h1)">Merhaba {{ customer.first_name | default: 'kahve sever' }}</h1>
    </div>
    <div style="display:flex;gap:.6rem">
      <a href="{{ routes.account_addresses_url }}" class="btn btn--ghost">{{ 'customer.account.addresses' | t }}</a>
      <a href="{{ routes.account_logout_url }}" class="btn btn--ghost">{{ 'customer.account.logout' | t }}</a>
    </div>
  </header>

  <h2 style="font-family:var(--font-mono);font-size:var(--fs-micro);letter-spacing:.2em;text-transform:uppercase;color:var(--ember);margin-bottom:1rem">{{ 'customer.account.orders' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <div class="glass" style="padding:1.2rem;overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:.9rem">
        <thead><tr style="font-family:var(--font-mono);font-size:var(--fs-micro);text-transform:uppercase;letter-spacing:.1em;color:var(--paper-faint);text-align:left">
          <th style="padding:.6rem">Sipariş</th><th>Tarih</th><th>Durum</th><th style="text-align:right">Tutar</th></tr></thead>
        <tbody>
        {%- for order in customer.orders -%}
          <tr style="border-top:1px solid var(--glass-border-dark)">
            <td style="padding:.7rem .6rem"><a href="{{ order.customer_url }}" style="color:var(--ember)">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
            <td><span class="chip">{{ order.financial_status_label }}</span></td>
            <td style="text-align:right;font-family:var(--font-mono)">{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
        </tbody>
      </table>
    </div>
  {%- else -%}
    <div class="glass center" style="padding:3rem"><p class="muted">Henüz siparişin yok.</p><a href="{{ routes.all_products_collection_url }}" class="btn" style="margin-top:1rem">İlk kahveni seç {% render 'icon', name: 'arrow' %}</a></div>
  {%- endif -%}
</section>
