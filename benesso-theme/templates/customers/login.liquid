<section class="section wrap" style="max-width:460px;margin-inline:auto">
  <div class="glass" style="padding:clamp(1.8rem,4vw,2.6rem)">
    <span class="eyebrow">{% render 'icon', name: 'user' %} HESABIM</span>
    <h1 class="section-title" style="font-size:var(--fs-h2);margin-bottom:1.4rem">{{ 'customer.login.title' | t }}</h1>
    {%- form 'customer_login', class: 'stack' -%}
      {{ form.errors | default_errors }}
      <label class="opt-group__label" for="ce">{{ 'customer.login.email' | t }}</label>
      <input type="email" name="customer[email]" id="ce" required style="width:100%;padding:.85rem 1.1rem;border-radius:var(--radius-sm);background:var(--glass-bg);border:1px solid var(--glass-border);color:inherit;font:inherit">
      <label class="opt-group__label" for="cp">{{ 'customer.login.password' | t }}</label>
      <input type="password" name="customer[password]" id="cp" required style="width:100%;padding:.85rem 1.1rem;border-radius:var(--radius-sm);background:var(--glass-bg);border:1px solid var(--glass-border);color:inherit;font:inherit">
      <button type="submit" class="btn btn--block" data-magnetic style="margin-top:.5rem">{{ 'customer.login.submit' | t }}</button>
    {%- endform -%}
    <div class="divider"></div>
    <a href="{{ routes.account_register_url }}" class="btn btn--ghost btn--block">{{ 'customer.login.register' | t }}</a>
  </div>
</section>
