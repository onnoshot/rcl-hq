{%- liquid
  assign product = section.settings.product
-%}
<section class="section wrap" data-section-id="{{ section.id }}">
  <div class="glass" style="padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-lg);overflow:hidden;position:relative">
    <div class="grid" style="grid-template-columns:1fr 1fr;gap:clamp(1.5rem,4vw,3rem);align-items:center">
      <div class="reveal-left">
        <span class="eyebrow">{% render 'icon', name: 'cup' %} {{ section.settings.eyebrow }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="lede" style="margin:1rem 0 1.6rem">{{ section.settings.text }}</p>
        <ul class="stack" style="margin-bottom:1.8rem">
          {%- for block in section.blocks -%}
            <li class="reveal" style="display:flex;gap:.8rem;align-items:flex-start">
              <span style="color:var(--ember);flex:none;width:22px">{% render 'icon', name: 'arrow' %}</span>
              <span><strong>{{ block.settings.title }}</strong> — <span class="muted">{{ block.settings.text }}</span></span>
            </li>
          {%- endfor -%}
        </ul>
        {%- if product != blank -%}
          <a href="{{ product.url }}" class="btn" data-magnetic>{{ section.settings.cta | default: 'Tadım setini incele' }} {% render 'icon', name: 'arrow' %}</a>
        {%- elsif section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="btn" data-magnetic>{{ section.settings.cta }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
      <div class="reveal-right" style="position:relative">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="" width="640" height="640" style="border-radius:var(--radius);aspect-ratio:1;object-fit:cover" data-parallax="0.05" loading="lazy">
        {%- elsif product.featured_media != blank -%}
          <img src="{{ product.featured_media | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="640" height="640" style="border-radius:var(--radius);aspect-ratio:1;object-fit:cover" loading="lazy">
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if product != blank -%}
          <div class="hero__card glass--light glass" style="position:absolute;bottom:-1rem;right:-1rem;animation:floatY 5s var(--ease-glass) infinite">
            <div class="stat__num" style="color:var(--orange)">{% render 'price', product: product %}</div>
            <div class="stat__label" style="color:var(--ink-soft)">başlangıç seti</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tadım Seti",
  "settings": [
    { "type": "product", "id": "product", "label": "Tadım seti ürünü" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "NEREDEN BAŞLAMALI" },
    { "type": "text", "id": "title", "label": "Başlık", "default": "Önce keşfet, sonra favorini seç" },
    { "type": "textarea", "id": "text", "label": "Metin", "default": "Tek bir kökene bağlanmadan önce farklı terroir'ları yan yana dene. Tadım setleri specialty dünyasına en doğru giriş." },
    { "type": "text", "id": "cta", "label": "Buton", "default": "Tadım setini incele" },
    { "type": "url", "id": "link", "label": "Yedek link" },
    { "type": "image_picker", "id": "image", "label": "Görsel" }
  ],
  "blocks": [
    { "type": "point", "name": "Madde", "settings": [
      { "type": "text", "id": "title", "label": "Başlık", "default": "3 köken" },
      { "type": "text", "id": "text", "label": "Metin", "default": "yan yana karşılaştır" }
    ]}
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Tadım Seti", "blocks": [
    { "type": "point", "settings": { "title": "3–5 farklı köken", "text": "tek pakette yan yana" } },
    { "type": "point", "settings": { "title": "100'er gram", "text": "denemek için ideal porsiyon" } },
    { "type": "point", "settings": { "title": "Künye kartları", "text": "her kahvenin rakım/işleme bilgisi" } }
  ] }]
}
{% endschema %}
