{%- liquid
  assign sid = section.id
  assign has_header = false
  if section.settings.eyebrow != blank or section.settings.title != blank
    assign has_header = true
  endif
-%}

<section class="slider-sec {% unless section.settings.full_width %}wrap{% endunless %}" data-section-id="{{ sid }}">
  {%- if has_header -%}
    <header class="slider-sec__head wrap reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{% render 'icon', name: 'bean' %} {{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
    </header>
  {%- endif -%}

  <div
    class="slider reveal-scale"
    data-slider
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
    style="--slider-radius:{% if section.settings.full_width %}0{% else %}var(--radius-lg){% endif %}"
  >
    <div class="slider__track" data-slider-track>
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        <div class="slide" data-slide {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="slide__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | default: 'slide' | escape }}">{%- endif -%}

          {%- if img != blank -%}
            <img
              class="slide__img"
              src="{{ img | image_url: width: 1600 }}"
              srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w"
              sizes="{% if section.settings.full_width %}100vw{% else %}min(100vw, var(--maxw)){% endif %}"
              alt="{{ block.settings.title | escape }}"
              width="1600" height="900"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {% if forloop.first %}fetchpriority="high"{% endif %}>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'slide__img placeholder' }}
          {%- endif -%}

          {%- if block.settings.title != blank or block.settings.text != blank -%}
            <div class="slide__overlay slide__overlay--{{ block.settings.align }}">
              <div class="slide__caption">
                {%- if block.settings.tag != blank -%}<span class="slide__tag">{{ block.settings.tag }}</span>{%- endif -%}
                {%- if block.settings.title != blank -%}<h3 class="slide__title">{{ block.settings.title }}</h3>{%- endif -%}
                {%- if block.settings.text != blank -%}<p class="slide__text">{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- else -%}
        <div class="slide" data-slide>{{ 'lifestyle-1' | placeholder_svg_tag: 'slide__img placeholder' }}</div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_dots and section.blocks.size > 1 -%}
      <div class="slider__dots" data-slider-dots role="tablist" aria-label="Slaytlar">
        {%- for block in section.blocks -%}
          <button class="slider__dot{% if forloop.first %} is-active{% endif %}" data-slider-dot="{{ forloop.index0 }}" type="button" aria-label="Slayt {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.slider-sec { padding-block: clamp(2rem, 5vw, 4rem); }
.slider-sec__head { margin-bottom: 1.8rem; }
.slider {
  position: relative;
  border-radius: var(--slider-radius, var(--radius-lg));
  overflow: hidden;
  box-shadow: var(--glass-shadow-lg);
}
.slider__track {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.slider__track::-webkit-scrollbar { display: none; }
.slide {
  position: relative;
  flex: 0 0 100%;
  width: 100%;
  scroll-snap-align: center;
  scroll-snap-stop: always;
  aspect-ratio: 16 / 9;
}
.slide__link { display: block; width: 100%; height: 100%; }
.slide__img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.slide__overlay {
  position: absolute; inset: 0;
  display: flex;
  padding: clamp(1.2rem, 4vw, 3rem);
  background: linear-gradient(to top, rgba(15,10,6,.78), rgba(15,10,6,.10) 55%, transparent 80%);
}
.slide__overlay--left   { align-items: flex-end;  justify-content: flex-start; text-align: left; }
.slide__overlay--center { align-items: center;    justify-content: center;     text-align: center; background: linear-gradient(to top, rgba(15,10,6,.55), rgba(15,10,6,.30)); }
.slide__overlay--right  { align-items: flex-end;  justify-content: flex-end;   text-align: right; }
.slide__caption { max-width: 46ch; color: var(--crema, #fff); }
.slide__tag {
  display: inline-block;
  font-family: var(--font-mono, monospace);
  font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;
  color: #fff;
  padding: .35rem .8rem; margin-bottom: .8rem;
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-pill);
  background: var(--glass-dark);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
}
.slide__title { font-size: clamp(1.5rem, 4vw, 2.8rem); line-height: 1.05; color: #fff; }
.slide__text  { margin-top: .6rem; font-size: clamp(.95rem, 1.6vw, 1.15rem); color: rgba(255,255,255,.82); }

.slider__dots {
  position: absolute; left: 0; right: 0; bottom: clamp(.9rem, 2vw, 1.4rem);
  display: flex; justify-content: center; gap: .5rem; z-index: 2;
}
.slider__dot {
  width: 8px; height: 8px; padding: 0;
  border: 0; border-radius: 999px; cursor: pointer;
  background: rgba(255,255,255,.45);
  transition: width var(--dur-s, .3s) var(--ease-glass), background var(--dur-s, .3s) var(--ease-glass);
}
.slider__dot.is-active { width: 26px; background: var(--orange); }

@media (prefers-reduced-motion: reduce) {
  .slider__track { scroll-behavior: auto; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function initSlider(root) {
    if (root.dataset.sliderReady) return;
    root.dataset.sliderReady = '1';

    var track = root.querySelector('[data-slider-track]');
    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-slider-dot]');
    if (!track || slides.length < 2) return;

    var current = 0;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setActive(i) {
      current = i;
      dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
    }
    function goTo(i) {
      var slide = slides[i];
      if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    }

    // sync dots while user swipes
    var raf;
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== current) setActive(Math.max(0, Math.min(slides.length - 1, i)));
      });
    }, { passive: true });

    dots.forEach(function (d) {
      d.addEventListener('click', function () { goTo(parseInt(d.dataset.sliderDot, 10)); });
    });

    // autoplay (pauses on hover / touch / tab hidden)
    if (root.dataset.autoplay === 'true' && !reduce) {
      var interval = parseInt(root.dataset.interval, 10) || 5000;
      var timer = null;
      function start() { stop(); timer = setInterval(function () { goTo((current + 1) % slides.length); }, interval); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      track.addEventListener('touchstart', stop, { passive: true });
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      start();
    }
  }

  function boot() { document.querySelectorAll('[data-slider]').forEach(initSlider); }
  document.readyState !== 'loading' ? boot() : document.addEventListener('DOMContentLoaded', boot);
  // re-init when a slider is added in the theme editor
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('[data-slider]').forEach(initSlider);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Görsel Slider",
  "tag": "section",
  "class": "section-image-slider",
  "settings": [
    { "type": "header", "content": "Başlık (opsiyonel)" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket" },
    { "type": "text", "id": "title", "label": "Başlık" },
    { "type": "header", "content": "Görünüm" },
    { "type": "checkbox", "id": "full_width", "label": "Tam genişlik (kenardan kenara)", "default": false },
    { "type": "checkbox", "id": "show_dots", "label": "Nokta göstergeleri", "default": true },
    { "type": "header", "content": "Otomatik oynatma" },
    { "type": "checkbox", "id": "autoplay", "label": "Otomatik geçiş", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Geçiş süresi", "unit": "sn", "min": 3, "max": 12, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slayt",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel (16:9 önerilir, ör. 1600×900)" },
        { "type": "text", "id": "tag", "label": "Etiket (küçük üst yazı)" },
        { "type": "text", "id": "title", "label": "Başlık" },
        { "type": "textarea", "id": "text", "label": "Açıklama" },
        { "type": "select", "id": "align", "label": "Yazı hizası", "options": [
            { "value": "left", "label": "Sol alt" },
            { "value": "center", "label": "Orta" },
            { "value": "right", "label": "Sağ alt" }
          ], "default": "left" },
        { "type": "url", "id": "link", "label": "Bağlantı (opsiyonel)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Görsel Slider",
      "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}
