{%- liquid
  assign product = product
  assign cf = product.metafields.coffee
  assign current = product.selected_or_first_available_variant
-%}
<section class="section wrap" data-section-id="{{ section.id }}" id="ProductSection" data-product-id="{{ product.id }}">
  <div class="pdp">
    <!-- Gallery -->
    <div class="pdp__media reveal-left">
      <div class="pdp__main-img">
        {%- if product.featured_media != blank -%}
          <img data-pdp-main src="{{ product.featured_media | image_url: width: 1100 }}" alt="{{ product.featured_media.alt | escape }}" width="900" height="900" fetchpriority="high">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for media in product.media limit: 6 -%}
            <button data-pdp-thumb data-full="{{ media | image_url: width: 1100 }}" class="{% if forloop.first %}is-active{% endif %} glass" type="button" aria-label="Görsel {{ forloop.index }}">
              <img src="{{ media | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Buy box -->
    <div class="pdp__info reveal-right">
      <nav class="muted" style="font-family:var(--font-mono);font-size:var(--fs-micro);letter-spacing:.12em;text-transform:uppercase">
        <a href="{{ routes.root_url }}">Anasayfa</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title | replace: ' | Benesso Coffee', '' }}</a>{% else %}<a href="{{ routes.all_products_collection_url }}">Kahveler</a>{% endif %}
      </nav>

      {%- if cf.country.value != blank -%}<span class="pcard__origin" style="margin-top:1rem;display:block">{% render 'icon', name: 'globe' %} {{ cf.country.value }}{% if cf.region.value != blank %} · {{ cf.region.value }}{% endif %}</span>{%- endif -%}
      <h1 class="pdp__title">{{ product.title | replace: ' - ', ' · ' }}</h1>

      {%- if cf.tasting_notes.value != blank -%}
        <div class="pcard__notes" style="margin-bottom:1rem">
          {%- assign notes = cf.tasting_notes.value | split: ',' -%}
          {%- for n in notes -%}<span class="chip chip--note">{% render 'icon', name: 'drop' %} {{ n | strip }}</span>{%- endfor -%}
        </div>
      {%- endif -%}

      <div class="pdp__price" data-price>{{ current.price | money }}</div>

      {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="opt-group">
              <span class="opt-group__label">{{ option.name }}</span>
              <div class="opt-pills" data-option-index="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  {%- assign checked = false -%}
                  {%- if option.selected_value == value -%}{%- assign checked = true -%}{%- endif -%}
                  <label class="opt-pill {% if checked %}is-checked{% endif %}">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" {% if checked %}checked{% endif %} data-opt>
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        <div class="pdp__buy">
          <div class="qty">
            <button type="button" data-qty-dn aria-label="Azalt">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-up aria-label="Arttır">+</button>
          </div>
          <button type="submit" class="btn btn--block" data-add-btn {% unless current.available %}disabled{% endunless %} data-magnetic>
            <span data-btn-label>{% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            {% render 'icon', name: 'cart' %}
          </button>
        </div>
      {%- endform -%}

      <ul class="grid" style="grid-template-columns:1fr 1fr;gap:.8rem;margin:1.5rem 0">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <li class="chip" style="justify-content:flex-start" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %} {{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {% render 'coffee-spec', product: product %}

      {%- if product.description != blank -%}
        <div class="rte muted" style="margin-top:1.6rem">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_related -%}
  {%- assign related = product.collections.first.products | default: collections.all.products -%}
  <section class="section wrap">
    <header class="reveal" style="margin-bottom:2rem"><span class="eyebrow">{% render 'icon', name: 'bean' %} BENZER KÖKENLER</span><h2 class="section-title">Bunları da seveceksin</h2></header>
    <div class="card-grid" data-stagger>
      {%- assign shown = 0 -%}
      {%- for p in related -%}
        {%- if p.id != product.id and shown < 4 -%}{% render 'product-card', product: p %}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

<script>
  (function () {
    var section = document.getElementById('ProductSection');
    if (!section) return;
    var variants = {{ product.variants | json }};
    var form = document.getElementById('ProductForm');
    var idField = section.querySelector('[data-variant-id]');
    var priceEl = section.querySelector('[data-price]');
    var addBtn = section.querySelector('[data-add-btn]');
    var btnLabel = section.querySelector('[data-btn-label]');

    function money(c){ return (c/100).toLocaleString('tr-TR',{minimumFractionDigits:2})+' ₺'; }
    function selectedOptions(){
      return Array.prototype.map.call(section.querySelectorAll('.opt-pills'), function(g){
        var checked = g.querySelector('input:checked'); return checked ? checked.value : null;
      });
    }
    function update(){
      var opts = selectedOptions();
      var match = variants.find(function(v){
        return opts.every(function(o,i){ return o === null || v.options[i] === o; });
      }) || variants[0];
      if(!match) return;
      idField.value = match.id;
      priceEl.textContent = money(match.price);
      if(match.available){ addBtn.disabled = false; btnLabel.textContent = {{ 'products.product.add_to_cart' | t | json }}; }
      else { addBtn.disabled = true; btnLabel.textContent = {{ 'products.product.sold_out' | t | json }}; }
    }
    section.querySelectorAll('[data-opt]').forEach(function(r){ r.addEventListener('change', update); });

    var qty = form.querySelector('[name=quantity]');
    section.querySelector('[data-qty-up]').addEventListener('click', function(){ qty.value = parseInt(qty.value||1)+1; });
    section.querySelector('[data-qty-dn]').addEventListener('click', function(){ qty.value = Math.max(1, parseInt(qty.value||1)-1); });
    update();
  })();
</script>

{% schema %}
{
  "name": "Ürün",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "İlgili ürünler", "default": true }
  ],
  "blocks": [
    { "type": "trust", "name": "Güven rozeti", "settings": [
      { "type": "select", "id": "icon", "label": "İkon", "options": [
        {"value":"truck","label":"Kargo"},{"value":"shield","label":"Kalkan"},{"value":"flame","label":"Kavurma"},{"value":"leaf","label":"Yaprak"},{"value":"cup","label":"Fincan"}
      ], "default": "truck" },
      { "type": "text", "id": "text", "label": "Metin", "default": "1–3 gün hızlı kargo" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "trust", "settings": { "icon": "flame", "text": "Siparişte taze kavrum" } },
      { "type": "trust", "settings": { "icon": "truck", "text": "1–3 gün hızlı kargo" } },
      { "type": "trust", "settings": { "icon": "shield", "text": "%100 arabica" } },
      { "type": "trust", "settings": { "icon": "leaf", "text": "Direct trade çekirdek" } }
    ]
  }
}
{% endschema %}
