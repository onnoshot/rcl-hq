<section class="section wrap" data-section-id="{{ section.id }}">
  <header class="reveal" style="margin-bottom:2.5rem">
    <span class="eyebrow">{% render 'icon', name: 'bean' %} {{ section.settings.eyebrow }}</span>
    <h2 class="section-title">{{ section.settings.title }}</h2>
  </header>
  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))" data-stagger>
    {%- for block in section.blocks -%}
      {%- assign coll = block.settings.collection -%}
      <a href="{{ coll.url | default: '#' }}" class="glass tilt" data-tilt style="display:block;position:relative;aspect-ratio:3/4;border-radius:var(--radius);overflow:hidden" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="" width="600" height="800" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .9s var(--ease-glass)" loading="lazy">
        {%- elsif coll.featured_image != blank -%}
          <img src="{{ coll.featured_image | image_url: width: 600 }}" alt="" width="600" height="800" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" loading="lazy">
        {%- endif -%}
        <span style="position:absolute;inset:0;background:linear-gradient(to top, rgba(15,10,6,.85), transparent 60%)"></span>
        <div style="position:absolute;left:0;right:0;bottom:0;padding:1.3rem">
          <span class="pcard__origin">{{ block.settings.tag }}</span>
          <h3 style="font-size:1.3rem;margin-top:.3rem">{{ block.settings.title | default: coll.title }}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Koleksiyon Vitrini",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "KATEGORİLER" },
    { "type": "text", "id": "title", "label": "Başlık", "default": "Neye göre demlersin?" }
  ],
  "blocks": [
    { "type": "coll", "name": "Koleksiyon", "settings": [
      { "type": "collection", "id": "collection", "label": "Koleksiyon" },
      { "type": "image_picker", "id": "image", "label": "Görsel" },
      { "type": "text", "id": "title", "label": "Başlık" },
      { "type": "text", "id": "tag", "label": "Etiket", "default": "KOLEKSİYON" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Koleksiyon Vitrini", "blocks": [
    { "type": "coll", "settings": { "title": "Yöresel Single-Origin", "tag": "NİTELİKLİ" } },
    { "type": "coll", "settings": { "title": "İmza Blendler", "tag": "KLASİK" } },
    { "type": "coll", "settings": { "title": "Türk Kahvesi", "tag": "GELENEKSEL" } },
    { "type": "coll", "settings": { "title": "Demleme Ekipmanları", "tag": "EKİPMAN" } }
  ] }]
}
{% endschema %}
