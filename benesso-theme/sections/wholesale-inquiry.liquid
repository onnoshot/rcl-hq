    #bw-{{ sid }} .bw__trust{gap:6px 12px; font-size:.8rem}
    #bw-{{ sid }} .bw__trust .bw__dot{display:none}
  }
  @media (prefers-reduced-motion:reduce){
    #bw-{{ sid }} .bw__orb, #bw-{{ sid }} .bw__bean{animation:none}
    #bw-{{ sid }} .bw-reveal, #bw-{{ sid }} .bw-card{transition:none; opacity:1; transform:none}
  }
</style>

{%- comment -%} ============ SCRIPT ============ {%- endcomment -%}
<script>
(function(){
  var root = document.getElementById('bw-{{ sid }}');
  if(!root || root.dataset.bwInit) return;
  root.dataset.bwInit = '1';

  var wa = (root.dataset.wa || '').trim();
  var brand = root.dataset.brand || 'Benesso';

  var VOL = {
    office:  {label:'Ekip b\u00fcy\u00fckl\u00fc\u011f\u00fc / ayl\u0131k t\u00fcketim', opts:['1-10 ki\u015fi','11-30 ki\u015fi','31-75 ki\u015fi','75+ ki\u015fi']},
    cafe:    {label:'Ayl\u0131k \u00e7ekirdek ihtiyac\u0131', opts:['5 kg alt\u0131','5-20 kg','20-50 kg','50 kg+']},
    event:   {label:'Etkinlik & misafir say\u0131s\u0131', opts:['50 ki\u015fiye kadar','50-150 ki\u015fi','150-500 ki\u015fi','500+ ki\u015fi']},
    label:   {label:'\u0130lk \u00fcretim adedi', opts:['250-500 adet','500-1.000 adet','1.000-5.000 adet','5.000+ adet']},
    _default:{label:'Tahmini ihtiya\u00e7', opts:['K\u00fc\u00e7\u00fck','Orta','B\u00fcy\u00fck','Hen\u00fcz net de\u011fil']}
  };

  // reveal \u2014 with fail-safe so cards never stay invisible
  function showAll(){ root.querySelectorAll('.bw-reveal, .bw-card').forEach(function(el){ el.classList.add('is-in'); }); }
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target);} });
    }, {threshold:.1});
    root.querySelectorAll('.bw-reveal, .bw-card').forEach(function(el,i){
      el.style.transitionDelay = (i%6 * 70) + 'ms';
      io.observe(el);
    });
    setTimeout(showAll, 1400);
  } else { showAll(); }

  var stepType = root.querySelector('[data-step="type"]');
  var stepForm = root.querySelector('[data-step="form"]');
  var chosenEl = root.querySelector('[data-chosen]');
  var volLabel = root.querySelector('[data-vol-label]');
  var volSel   = root.querySelector('[data-vol]');
  var form     = root.querySelector('[data-form]');
  var preview  = root.querySelector('[data-preview]');
  var current  = {key:'', label:''};

  function buildVolume(key){
    var cfg = VOL[key] || VOL._default;
    volLabel.textContent = cfg.label;
    volSel.innerHTML = '<option value="">Se\u00e7iniz</option>' +
      cfg.opts.map(function(o){return '<option>'+o+'</option>';}).join('');
  }

  function buildMessage(){
    var fd = new FormData(form);
    var L = [];
    L.push('Merhaba ' + brand + ', toptan / i\u015f ortakl\u0131\u011f\u0131 i\u00e7in yaz\u0131yorum.');
    L.push('');
    L.push('\u2022 Talep tipi: ' + (current.label || '-'));
    if(fd.get('name'))    L.push('\u2022 Ad Soyad: ' + fd.get('name'));
    if(fd.get('company')) L.push('\u2022 \u0130\u015fletme: ' + fd.get('company'));
    if(fd.get('city'))    L.push('\u2022 \u015eehir: ' + fd.get('city'));
    if(fd.get('volume'))  L.push('\u2022 ' + (VOL[current.key]||VOL._default).label + ': ' + fd.get('volume'));
    if(fd.get('note'))    L.push('\u2022 Not: ' + fd.get('note'));
    return L.join('\n');
  }

  function refresh(){ preview.textContent = buildMessage(); }

  function showForm(){
    stepType.setAttribute('hidden','');
    stepForm.removeAttribute('hidden');
    requestAnimationFrame(function(){ stepForm.classList.add('is-active'); });
    chosenEl.textContent = current.label;
    buildVolume(current.key);
    refresh();
    var y = root.getBoundingClientRect().top + window.pageYOffset - 20;
    window.scrollTo({top:y, behavior:'smooth'});
    var first = form.querySelector('input[name="name"]'); if(first) setTimeout(function(){first.focus();},420);
  }

  function showType(){
    stepForm.classList.remove('is-active');
    setTimeout(function(){ stepForm.setAttribute('hidden',''); stepType.removeAttribute('hidden'); }, 240);
  }

  root.querySelectorAll('[data-option]').forEach(function(btn){
    btn.addEventListener('click', function(){
      current.key = btn.dataset.key || '';
      current.label = btn.dataset.label || '';
      showForm();
    });
  });
  var back = root.querySelector('[data-back]'); if(back) back.addEventListener('click', showType);
  form.addEventListener('input', refresh);

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var name = form.querySelector('input[name="name"]');
    if(!name.value.trim()){ name.focus(); if(name.reportValidity) name.reportValidity(); return; }
    var msg = encodeURIComponent(buildMessage());
    var url = wa ? ('https://wa.me/' + wa + '?text=' + msg) : ('https://wa.me/?text=' + msg);
    window.open(url, '_blank', 'noopener');
  });
})();
</script>

