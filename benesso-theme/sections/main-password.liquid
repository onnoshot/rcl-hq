<div class="glass--strong glass center" style="padding:clamp(2rem,5vw,3.5rem);max-width:480px;width:100%;border-radius:var(--radius-lg)">
  <a href="{{ routes.root_url }}" class="site-logo" style="justify-content:center;font-size:1.8rem">{{ settings.logo_text }}<span>{{ settings.logo_accent }}</span></a>
  <span class="eyebrow" style="justify-content:center;margin-top:1rem">{% render 'icon', name: 'flame' %} ÇOK YAKINDA</span>
  <h1 class="section-title flow-text" style="margin-inline:auto;font-size:var(--fs-h2)">{{ section.settings.heading }}</h1>
  <p class="muted" style="margin:.8rem 0 1.6rem">{{ shop.password_message | default: section.settings.text }}</p>
  {%- form 'storefront_password', class: 'newsletter-form', style: 'justify-content:center' -%}
    <input type="password" name="password" placeholder="Şifre" aria-label="Şifre" required>
    <button type="submit" class="btn">{% render 'icon', name: 'arrow' %}</button>
    {%- if form.errors -%}<p class="chip chip--note" style="margin-top:1rem">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Şifre",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bir şeyler demleniyor" },
    { "type": "text", "id": "text", "label": "Metin", "default": "Yeni mağazamız çok yakında. Bültenimize katıl, ilk sen haberdar ol." }
  ]
}
{% endschema %}
